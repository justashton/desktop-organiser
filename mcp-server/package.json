{
  "name": "@desktop-organiser/mcp-server",
  "version": "0.1.0",
  "description": "Vendor-neutral MCP server that scans, classifies, plans, and safely applies file moves according to an ORGANISE.md rules file.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "desktop-organiser-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "exifr": "^7.1.3",
    "fast-glob": "^3.3.2",
    "micromatch": "^4.0.8",
    "pdf-parse": "^1.1.1",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/micromatch": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
